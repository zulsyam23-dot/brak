
fn pick(n: i32) -> i32 {
    let i = 0;
    while true {
        if i == n {
            return i * 2;
        }
        if true {
            return 99;
        }
    }
    return 0;
}

fn mid_if(x: i32) -> i32 {
    let y = if x > 0 { 10 } else { 20 };
    return y + 1;
}

fn main() -> i32 {
    let a = mid_if(5);
    let b = mid_if(-5);
    return pick(3) + a + b;
}
